        "lucide-react": "^0.468.0",
        "next": "^14.2.21",
        "openai": "^6.15.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwind-merge": "^2.6.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
