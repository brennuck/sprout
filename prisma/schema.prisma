generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions              Session[]
  accounts              Account[]
  envelopes             Envelope[]
  allocationPlans       AllocationPlan[]
  goalPreference        GoalPreference?
  payees                Payee[]
  scheduledTransactions ScheduledTransaction[]

  // Sharing relationships
  sharedWithMe    DashboardShare[] @relation("SharedWith")
  sharedByMe      DashboardShare[] @relation("SharedBy")
  sentInvites     Invitation[]     @relation("InviteSender")
  receivedInvites Invitation[]     @relation("InviteRecipient")

  @@map("users")
}

model DashboardShare {
  id         String          @id @default(cuid())
  permission SharePermission @default(VIEW)
  createdAt  DateTime        @default(now())

  ownerId String
  owner   User   @relation("SharedBy", fields: [ownerId], references: [id], onDelete: Cascade)

  viewerId String
  viewer   User   @relation("SharedWith", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, viewerId])
  @@map("dashboard_shares")
}

model Invitation {
  id         String           @id @default(cuid())
  email      String
  permission SharePermission  @default(VIEW)
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime

  senderId String
  sender   User   @relation("InviteSender", fields: [senderId], references: [id], onDelete: Cascade)

  // If the invited email matches an existing user
  recipientId String?
  recipient   User?   @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([email, status])
  @@map("invitations")
}

enum SharePermission {
  VIEW
  EDIT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(references: [id], fields: [userId], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id        String      @id @default(cuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]          @relation("AccountTransactions")
  transfersTo           Transaction[]          @relation("TransferToAccount")
  envelopes             Envelope[]
  allocationPlans       AllocationPlan[]
  scheduledTransactions ScheduledTransaction[] @relation("ScheduledAccount")
  scheduledTransfersTo  ScheduledTransaction[] @relation("ScheduledTransferTo")

  @@index([userId])
  @@map("accounts")
}

enum AccountType {
  SAVINGS
  BUDGET
  ALLOWANCE
  RETIREMENT
  STOCK
}

model Transaction {
  id          String          @id @default(cuid())
  amount      Decimal         @db.Decimal(12, 2)
  description String
  date        DateTime
  type        TransactionType
  createdAt   DateTime        @default(now())

  // Primary account (source for transfers/expenses, destination for income)
  accountId String
  account   Account @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)

  // For transfers: the destination account
  transferToAccountId  String?
  transferToAccount    Account?        @relation("TransferToAccount", fields: [transferToAccountId], references: [id], onDelete: SetNull)
  envelopeEntries      EnvelopeEntry[]
  goalImpactEnvelopeId String?
  goalImpactEnvelope   Envelope?       @relation("GoalImpactTransactions", fields: [goalImpactEnvelopeId], references: [id], onDelete: SetNull)

  notes String?

  payeeId String?
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: SetNull)

  scheduledTransactionId String?
  scheduledTransaction   ScheduledTransaction? @relation(fields: [scheduledTransactionId], references: [id], onDelete: SetNull)

  @@index([goalImpactEnvelopeId])
  @@index([accountId, date])
  @@index([type, date])
  @@index([payeeId])
  @@index([scheduledTransactionId])
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

model Payee {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  useCount       Int      @default(0)
  lastUsedAt     DateTime @default(now())
  lastEnvelopeId String?
  lastAccountId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]
  scheduledTransactions ScheduledTransaction[]

  @@unique([userId, normalizedName])
  @@index([userId, useCount])
  @@map("payees")
}

enum ScheduleFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model ScheduledTransaction {
  id           String            @id @default(cuid())
  description  String
  amount       Decimal           @db.Decimal(12, 2)
  type         TransactionType
  frequency    ScheduleFrequency
  weekday      Int?
  dayOfMonth   Int?
  month        Int?
  timezone     String
  nextDueAt    DateTime
  lastPostedAt DateTime?
  autoPost     Boolean           @default(false)
  enabled      Boolean           @default(true)
  endsAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation("ScheduledAccount", fields: [accountId], references: [id], onDelete: Cascade)

  transferToAccountId String?
  transferToAccount   Account? @relation("ScheduledTransferTo", fields: [transferToAccountId], references: [id], onDelete: SetNull)

  envelopeId String?
  envelope   Envelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)

  payeeId String?
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: SetNull)

  transactions Transaction[]

  @@index([userId, enabled, nextDueAt])
  @@index([accountId])
  @@index([envelopeId])
  @@map("scheduled_transactions")
}

model Envelope {
  id                  String              @id @default(cuid())
  name                String
  kind                EnvelopeKind        @default(BUDGET)
  icon                String?
  note                String?
  targetAmount        Decimal?            @db.Decimal(12, 2)
  monthlyTarget       Decimal?            @db.Decimal(12, 2)
  targetDate          DateTime?
  rollover            Boolean             @default(true)
  sortOrder           Int                 @default(0)
  recurringAmount     Decimal?            @db.Decimal(12, 2)
  recurringFrequency  RecurringFrequency?
  recurringWeekday    Int?
  recurringDayOfMonth Int?
  recurringTimezone   String?
  recurringEnabled    Boolean             @default(false)
  nextRecurringAt     DateTime?
  lastRecurringAt     DateTime?
  archivedAt          DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  entries                EnvelopeEntry[]
  allocationRules        AllocationRule[]
  focusPreferences       GoalPreference[]
  goalImpactTransactions Transaction[]          @relation("GoalImpactTransactions")
  scheduledTransactions  ScheduledTransaction[]

  @@index([userId, archivedAt, sortOrder])
  @@index([accountId])
  @@index([recurringEnabled, nextRecurringAt])
  @@map("envelopes")
}

enum EnvelopeKind {
  BUDGET
  SINKING_FUND
  GOAL
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
}

model EnvelopeEntry {
  id            String            @id @default(cuid())
  amount        Decimal           @db.Decimal(12, 2)
  type          EnvelopeEntryType
  note          String?
  groupId       String?
  recurrenceKey String?           @unique
  date          DateTime          @default(now())
  createdAt     DateTime          @default(now())

  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([envelopeId, date])
  @@index([transactionId])
  @@index([groupId])
  @@map("envelope_entries")
}

enum EnvelopeEntryType {
  ALLOCATION
  SPEND
  MOVE
  ADJUSTMENT
  WITHDRAWAL
}

model AllocationPlan {
  id        String   @id @default(cuid())
  name      String   @default("Paycheck plan")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  rules AllocationRule[]

  @@unique([userId, accountId])
  @@map("allocation_plans")
}

model AllocationRule {
  id        String               @id @default(cuid())
  method    AllocationRuleMethod
  value     Decimal              @default(0) @db.Decimal(12, 2)
  priority  Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  planId String
  plan   AllocationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@unique([planId, envelopeId])
  @@index([planId, priority])
  @@map("allocation_rules")
}

enum AllocationRuleMethod {
  FIXED
  PERCENT
  REMAINDER
}

model GoalPreference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goalEnvelopeId String
  goalEnvelope   Envelope @relation(fields: [goalEnvelopeId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([goalEnvelopeId])
  @@map("goal_preferences")
}
